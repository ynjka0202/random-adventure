<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!-- Статистик: нийт үзүүлэлт, 14 хоногийн XP, ангиллын харьцаа, хүндрэлээр. -->
<VBox spacing="18.0" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="mn.adventure.controller.StatsController">
   <VBox spacing="4.0">
      <Label styleClass="h1" text="Статистик" />
      <Label styleClass="muted" text="Таны ахиц дэвшил тоогоор" />
   </VBox>
   <HBox fx:id="summaryRow" spacing="16.0" />
   <HBox spacing="16.0">
      <VBox minWidth="460.0" spacing="12.0" styleClass="card" HBox.hgrow="ALWAYS">
         <HBox alignment="CENTER_LEFT">
            <Label styleClass="h2" text="Сүүлийн 14 хоногийн XP" />
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="xpTotalLabel" styleClass="xp-chip" text="Нийт 0 XP" />
         </HBox>
         <BarChart fx:id="xpChart" animated="false" categoryGap="10.0" legendVisible="false" prefHeight="300.0">
            <xAxis><CategoryAxis side="BOTTOM" /></xAxis>
            <yAxis><NumberAxis side="LEFT" /></yAxis>
         </BarChart>
      </VBox>
      <VBox maxWidth="340.0" minWidth="340.0" spacing="12.0" styleClass="card">
         <Label styleClass="h2" text="Ангиллаар" />
         <StackPane fx:id="pieHolder">
            <PieChart fx:id="categoryPie" animated="false" labelsVisible="false" legendVisible="false" prefHeight="260.0" prefWidth="320.0" startAngle="90.0" />
         </StackPane>
         <VBox fx:id="legendBox" spacing="6.0" />
      </VBox>
   </HBox>
   <VBox spacing="12.0" styleClass="card">
      <Label styleClass="h2" text="Хүндрэлээр" />
      <HBox fx:id="difficultyRow" spacing="24.0" />
   </VBox>
</VBox>
